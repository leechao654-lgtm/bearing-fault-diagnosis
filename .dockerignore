# =============================================================
# Files excluded from Docker build context
# Keeps the image small and avoids copying sensitive/large files
# =============================================================

# Dataset (large — mount as volume instead)
paderborn_data/
data/

# MLflow artefacts
# mlruns/ is intentionally NOT ignored — the Dockerfile COPYs it so the model
# is baked into the image. Local dev uses the docker-compose volume mount instead.
mlflow.db

# Notebooks and training-only files
*.ipynb
*.ipynb_checkpoints/
plots/
*.pkl

# Unit tests (live in utils/ alongside the code they test, but are dev/CI-only)
utils/test_features.py

# Python build artefacts
__pycache__/
*.py[cod]
*.pyo

# Git and tooling
.git/
.gitignore
.claude/
CLAUDE.md

# Credentials
.env
.kaggle/
kaggle.json

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Docs
*.pdf
README.md
